{
  "name": "coding-and-robotics-lab",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "milestone-robotics",
      "database_id": "983c8f91-e8b2-421e-b927-ed9947217ac2"
    }
  ],
  "keep_vars": true,
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "MPESA_ENV": "production",
    "MPESA_TYPE": "till",
    "MPESA_PARTYB": "1844024"
  }
}
